# SPDX-License-Identifier: GPL-3.0-only
CORE_REPOSITORY=https://github.com/daeuniverse/honk.git
CORE_COMMIT=1b95e2e90ac949e248270a746058eaab3f7de381
# The upstream commit the last build reacted to. The honk core is tracked by
# the upstream main branch head, gated on that commit's own upstream CI being
# green, so the daily job compares the newest proven commit against this one.
# An unchanged commit means the branch head is still the one already built and
# the run stays silent.
#
# The native API landed in the official main branch on 2026-10-20 (PR #299),
# so this repository tracks daeuniverse/honk directly.
CORE_RELEASE=1b95e2e90ac949e248270a746058eaab3f7de381
DOONA_REPOSITORY=https://github.com/Zakkaus/doona.git
DOONA_COMMIT=f896a2176460daa0997497cd964d84c697e717b2
DOONA_RELEASE=v0.1.0-rc.1
DOONA_VERSION=0.1.0-rc.1
DOONA_PATCH=ci/patches/doona-openwrt.patch
DOONA_PATCH_SHA256=7cc1e936a25c116177c90c279156d70cff757556891cd52dfa6ef5c93cc7fb9e
DOONA_PNPM_VERSION=11.15.1
DOONA_ARCHIVE=doona-f896a217-b0897cc7596e.tar.gz

# ---------------------------------------------------------------------------
# Upstream green-gate
# ---------------------------------------------------------------------------
# The upstream honk CI decides which upstream commit is usable: a commit is
# only accepted when every lane below finished with "success". The list lives
# here instead of inside the workflow so a lane rename does not require a
# workflow edit, and so the same list can be asserted by scripts/check.sh.
#
# A lane that is renamed upstream turns into "missing" here, which fails the
# gate loudly (the run errors out) instead of silently promoting an older
# commit.
UPSTREAM_REQUIRED_LANES='changes|docs|fmt + clippy|cargo nextest (workspace)|cargo nextest (aarch64)|DNS smoke (release honk-core)|dae-config parser (conformance + fuzz replay)|eBPF feature compile guard|eBPF object + real VM kernel tests|eBPF real VM tests (recent kernel)|Independent feature sets|x86_64 musl release path'
# How far back from the upstream branch head the gate may walk when the newest
# commit is still being tested. Each step is one API round trip per lane.
UPSTREAM_LOOKBACK=20
BPF_LINKER_VERSION=0.11.0
BPF_LINKER_SHA256=10f62ba9ab7e544d538370552660efcb4f1a19153d5752bbf0f6b51f3bada450
ZIG_VERSION=0.14.1
ZIG_URL=https://ziglang.org/download/0.14.1/zig-x86_64-linux-0.14.1.tar.xz
ZIG_SHA256=24aeeec8af16c381934a6cd7d95c807a8cb2cf7df9fa40d359aa884195c4716c
# The Rust toolchains are not pinned here: ci/build-core.sh reads both the
# stable channel (rust-toolchain.toml) and the eBPF nightly
# (crates/honk-ebpf/rust-toolchain.toml) back from the pinned upstream
# checkout, so an upstream toolchain bump cannot leave us building against a
# nightly that no longer exists.

# ---------------------------------------------------------------------------
# apk-native packaging (replaces the OpenWrt SDK; 25.12+ only, no opkg/ipk)
# ---------------------------------------------------------------------------

# The OpenWrt release the R2 feed is addressed under: feed/<release>/<arch>/.
# The packages use the apk 3.0.0_pre1 container format, so they install on
# 25.12 and newer; the directory name is the only thing that has to follow
# the device's release, and it lives here instead of in the workflow.
OPENWRT_RELEASE=25.12

# Target package architectures, in OpenWrt ARCH_PACKAGES spelling. Each one
# becomes its own honk package; luci-app-honk is arch-independent.
OPENWRT_ARCHS=${OPENWRT_ARCHS:-"aarch64_cortex-a53 aarch64_cortex-a72 aarch64_generic arm_cortex-a7_neon-vfpv4 arm_cortex-a9 x86_64"}

# apk-tools provides `apk mkpkg` (the packaging primitive) and `apk mkndx`
# (the feed index). OpenWrt 25.12 ships apk-tools 3.0.5, whose package
# container default is `compat=3.0.0_pre1`; 3.0.8 is identical in that respect,
# so packages built here stay readable by the apk on the device.
APK_TOOLS_VERSION=3.0.8-r0
APK_TOOLS_UPSTREAM=3.0.8
APK_TOOLS_URL=https://dl-cdn.alpinelinux.org/alpine/v3.23/main/x86_64/apk-tools-static-3.0.8-r0.apk
APK_TOOLS_SHA256=2edccd3267ce540f8d2371a0f394e84b40d8348ecc28425309e6d07079ed1259
# Must match the container format the device's apk understands. See the
# `compat` default in apk-tools' src/app_mkpkg.c.
APK_COMPAT=3.0.0_pre1

# po2lmo turns the LuCI .po catalogue into the .lmo blob the web UI loads.
# It is a host tool the SDK used to build from the luci feed; here it is built
# from the same pinned sources. lemon (from contrib/) generates
# lib/plural_formula.c from lib/plural_formula.y, which lib/lmo.c needs.
LUCI_COMMIT=0a601b651af34ae4a83dd89f417dccdc474ec348
LUCI_BASE_URL=https://raw.githubusercontent.com/openwrt/luci/$LUCI_COMMIT/modules/luci-base/src
PO2LMO_SHA256_PO2LMO_C=567caad86e85332a026bc502e10f3f16eb5ef8cb0a7637623217c1a1ba2111ef
PO2LMO_SHA256_LIB_LMO_C=1c42aaa581a2a9f6333bce2acd39d3651765b74f6f2513af0a3e295434b06153
PO2LMO_SHA256_LIB_LMO_H=0cba114fdc0588cd2d372881c1380ae4f4736043aef0d029dfa486c4dde87206
PO2LMO_SHA256_LIB_PLURAL_FORMULA_Y=92b89b38b4076dd2ce093784ba781cbb405f3d7fa6068e05ac6ff0e4cb3bdc01
PO2LMO_SHA256_CONTRIB_LEMON_C=2db13d122c17fa204073aec232a1949714b8c8df6e150b8727557750b5848e35
PO2LMO_SHA256_CONTRIB_LEMPAR_C=f0a1197034470e664534f49955e11be36573a76fcb3363a65bbd2abbd0f03968
