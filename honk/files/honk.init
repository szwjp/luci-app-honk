#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

. /lib/functions.sh

HONK_CONTROL=/usr/share/honk/control.sh
HONK_CONFIG=/etc/honk/config.dae

# The WAN readiness helpers decide whether the WAN is usable yet. A missing
# helper must not hold the core back, so the fallback reports "ready" and
# the service starts the way it always did.
if [ -r /usr/share/honk/wan.sh ]; then
	. /usr/share/honk/wan.sh
else
	honk_wan_ready() { return 0; }
	honk_wan_gate_blocks() { return 1; }
fi

# The lifecycle helpers know whether a managed core is running.
if [ -r /usr/share/honk/lifecycle.sh ]; then
	. /usr/share/honk/lifecycle.sh
fi

# Is a managed core running? The procd instance is the authority, but the
# process table still knows a core when the instance list is gone.
#
# The procd helpers of the shell library cannot be used for this: they dump
# and clean up the JSON context that the instance registration below
# builds, so asking them inside start_service would empty that context.
honk_core_running() {
	command -v honk_lifecycle_procd_running >/dev/null 2>&1 || return 1
	case "$(honk_lifecycle_procd_running 2>/dev/null)" in
		true|1) return 0 ;;
	esac
	honk_lifecycle_find_core >/dev/null 2>&1 && return 0
	return 1
}

boot() {
	local boot_enabled
	config_load honk
	config_get_bool boot_enabled main boot_enabled 0
	[ "$boot_enabled" -eq 1 ] || return 0
	uci set honk.main.enabled='1' || return 1
	uci commit honk || return 1
	start
}

start_service() {
	local enabled initialized config_file
	config_load honk
	config_get_bool enabled main enabled 0
	config_get_bool initialized main initialized 0
	[ "$enabled" = 1 ] && [ "$initialized" = 1 ] || {
		logger -t honk "refusing to start before explicit initialization and enablement"
		return 1
	}
	config_get config_file main config_file "$HONK_CONFIG"
	[ "$config_file" = "$HONK_CONFIG" ] || {
		logger -t honk "refusing non-default config path"
		return 1
	}
	# A core that already runs is registered again, so that procd keeps the
	# running process: the instance it holds and the one registered here
	# are the same. The preflight is skipped for it, because it would fail
	# on the tun device that the running core holds, and an empty instance
	# list would stop a healthy service.
	if honk_core_running; then
		honk_register_core
		return 0
	fi
	# The WAN gate. honk resolves its WAN interface from the uplink, and a
	# PPPoE router only has one after the dial finished. A core that
	# starts before that binds the LAN hook without a WAN hook, which
	# leaves every node failing its health check and keeps the UDP as well
	# as the multi leaf node groups fail closed.
	#
	# The gate belongs to the boot sequence only, and the interface hotplug
	# script starts the core once the WAN arrives.
	if honk_wan_gate_blocks; then
		logger -t honk "the WAN is not ready yet; the start is deferred until it comes up"
		return 0
	fi
	"$HONK_CONTROL" preflight || return 1
	unset HONK_MAINT_CAP
	honk_register_core
}

honk_register_core() {
	procd_open_instance main
	procd_set_param command /usr/bin/honk-core --config "$HONK_CONFIG" --disable-timestamp
	# procd_set_param env REPLACES the whole environment list, so every variable
	# has to be set in one call. Two calls left only the last one in procd.json,
	# which dropped DAE_LOCATION_ASSET: the core could not find
	# /usr/share/v2ray/geoip.dat and geosite.dat, so all geo matchers were
	# unavailable and the mainland routing rules silently did nothing.
	# The mimalloc build holds freed memory until the purge delay elapses, which
	# keeps the geodata update from giving the memory back to the system.
	procd_set_param env DAE_LOCATION_ASSET=/usr/share/v2ray MIMALLOC_PURGE_DELAY=0
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param stdout 1
	procd_set_param stderr 1
	# The retry limit is zero, which respawns the instance for ever.
	# procd gives up on an instance once its crashes exceed the limit, so
	# a core that died five times within the threshold stayed down until
	# the router was rebooted, and a WAN that flapped could leave the
	# service dead for the rest of the day. The interval keeps a core that
	# cannot start at all from spinning.
	procd_set_param respawn 3600 30 0
	procd_set_param term_timeout 20
	procd_close_instance
}

reload_service() {
	# honk-core reload asks the running instance to re-read its configuration
	# without stopping it. The core refuses the fields that need a restart and
	# says so in the log; the restart below is the fallback for a request the
	# instance could not accept at all.
	if /usr/bin/honk-core reload >/dev/null 2>&1; then
		logger -t honk "reload requested"
		return 0
	fi
	logger -t honk "reload request failed, restarting"
	restart
}
